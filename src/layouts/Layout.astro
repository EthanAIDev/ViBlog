---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site } from '../../site.config.mjs';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  page?: string;
}

const {
  title = 'Ethan — AI Agent 工程实验室',
  description = 'Ethan，AI Agent 开发工程师。把想法，变成会工作的系统。专注智能体编排、RAG 检索与 Text-to-SQL。',
  page = 'home',
} = Astro.props;

const canonical = Astro.site && page !== '404' ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const shareImage = Astro.site ? new URL('/social/cover.jpg', Astro.site).href : '/social/cover.jpg';
const pageAnimation = {
  old: { name: 'page-exit', duration: '110ms', easing: 'cubic-bezier(0.4, 0, 1, 1)' },
  new: { name: 'page-enter', duration: '240ms', easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
};
---
<!doctype html>
<html lang="zh-CN" data-theme="dark" data-theme-pref="system" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Ethan" />
    <meta name="robots" content={site.indexable && page !== '404' ? 'index, follow' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#070a10" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('viblog-theme');
          const pref = saved === 'light' || saved === 'dark' || saved === 'system' ? saved : 'system';
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          const resolved = pref === 'system' ? (prefersLight ? 'light' : 'dark') : pref;
          document.documentElement.dataset.themePref = pref;
          document.documentElement.dataset.theme = resolved;
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', resolved === 'light' ? '#f6f8fb' : '#070a10');
        } catch {}
      })();
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={page === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content="Ethan · AI Agent 工程实验室" />
    <meta property="og:locale" content="zh_CN" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ethan 的个人主页：AI Agent 精密工程实验室" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body class:list={[`page-${page}`]}>
    <div class="site-ambient" transition:persist="site-ambient" aria-hidden="true">
      <div class="site-ambient-grid" />
      <div class="site-cursor-glow" />
      <div class="site-cursor-grid" />
    </div>

    <a class="skip-link" href="#main">跳到主要内容</a>

    <header class="site-header" transition:name="site-header" transition:persist="site-header" transition:animate="none">
      <a class="wordmark" href="/" aria-label="Ethan 首页">ETHAN</a>
      <span class="header-role">AI Agent 开发工程师</span>
      <nav class="primary-nav" aria-label="主导航">
        <a href="/posts/" aria-current={page === 'posts' || page === 'article' ? 'page' : undefined}>文章</a>
        <a href="/projects/" aria-current={page === 'projects' || page === 'project' ? 'page' : undefined}>项目</a>
        <a href="/about/" aria-current={page === 'about' ? 'page' : undefined}>关于</a>
      </nav>
      <div class="theme-switch" role="radiogroup" aria-label="外观主题" data-theme-switch>
        <span class="theme-switch-thumb" aria-hidden="true" />
        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-theme-choice="dark"
          aria-label="深色主题"
          title="深色主题"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>
        <button
          type="button"
          role="radio"
          aria-checked="true"
          data-theme-choice="system"
          aria-label="跟随系统"
          title="跟随系统"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="14" rx="2" />
            <path d="M8 21h8M12 17v4" />
          </svg>
        </button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-theme-choice="light"
          aria-label="浅色主题"
          title="浅色主题"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
        </button>
      </div>
    </header>

    <noscript>
      <p class="no-script-note">文章与项目仍可直接阅读；三维芯片交互、主题切换与筛选需要启用 JavaScript。</p>
    </noscript>

    <main id="main" transition:name="page-content" transition:animate={{ forwards: pageAnimation, backwards: pageAnimation }}>
      <slot />
    </main>

    <button
      type="button"
      class="floating-top"
      data-back-to-top
      aria-label="返回页面顶部"
      aria-hidden="true"
      tabindex="-1"
    >
      <Icon name="up" size={16} />
    </button>

    <footer class="site-footer">
      <div class="footer-bottom">
        <span>© 2025–{new Date().getFullYear()} Ethan · CC BY-NC 4.0</span>
        <span>用感觉编码，用日志留下痕迹。</span>
        <a href="https://github.com/EthanAIDev" target="_blank" rel="noopener noreferrer">GitHub <Icon name="diagonal" size={13} /></a>
      </div>
    </footer>

    <script>import '../lib/site';</script>
  </body>
</html>
