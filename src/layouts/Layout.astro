---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/noto-serif-sc';
import '@fontsource-variable/noto-sans-sc';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import '../styles/theatre.css';
import Icon from '../components/Icon.astro';
import {site} from '../../site.config.mjs';
import {ClientRouter} from 'astro:transitions';
interface Props { title?: string; description?: string; page?: string; heroPreloads?: {desktop:string;mobile:string}[]; }
const { title = 'Ethan — 认知剧场', description = 'Ethan，AI Agent 开发工程师。把想法，变成会工作的系统。', page = 'home', heroPreloads=[] } = Astro.props;
const canonical=Astro.site&&page!=='404'?new URL(Astro.url.pathname,Astro.site).href:undefined;
const shareImage=Astro.site?new URL('/social/cover.jpg',Astro.site).href:'/social/cover.jpg';
const pageAnimation={old:{name:'page-exit',duration:'90ms',easing:'ease-out'},new:{name:'page-enter',duration:'170ms',easing:'cubic-bezier(.16,1,.3,1)'}};
---
<!doctype html>
<html lang="zh-CN" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Ethan" />
    <meta name="robots" content={site.indexable&&page!=='404'?'index, follow':'noindex, nofollow'} />
    {canonical&&<link rel="canonical" href={canonical}/>}
    <meta name="theme-color" content="#080b11" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={page === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content="Ethan · 认知剧场" />
    <meta property="og:locale" content="zh_CN" />
    {canonical&&<meta property="og:url" content={canonical}/>}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ethan 的个人主页：深蓝黑展厅中的银色环形雕塑" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {heroPreloads.map(image=><><link rel="preload" as="image" href={image.desktop} media="(min-width: 761px)" fetchpriority="high"/><link rel="preload" as="image" href={image.mobile} media="(max-width: 760px)" fetchpriority="high"/></>)}
    <ClientRouter fallback="swap"/>
  </head>
  <body class:list={[`page-${page}`]}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header" transition:name="site-header" transition:persist="site-header" transition:animate="none">
      <a class="wordmark" href="/" aria-label="Ethan 首页">ETHAN</a><span class="header-role">AI Agent 开发工程师</span>
      <nav class="primary-nav" aria-label="主导航">
        <a href="/posts/" aria-current={page === 'posts' || page === 'article' ? 'page' : undefined}>文章</a>
        <a href="/projects/" aria-current={page === 'projects' || page === 'project' ? 'page' : undefined}>项目</a>
        <a href="/about/" aria-current={page === 'about' ? 'page' : undefined}>关于</a>
      </nav>
    </header>
    <noscript><style is:inline>.theatre[data-renderer=loading] .theatre-poster{opacity:1;visibility:visible;animation:none}.theatre-arrival,.theatre-ambient{display:none}</style><p class="no-script-note">文章与项目仍可直接阅读；装置交互和筛选需要启用 JavaScript。</p></noscript>
    <main id="main" transition:name="page-content" transition:animate={{forwards:pageAnimation,backwards:pageAnimation}}><slot /></main>
    <footer class="site-footer">
      <div class="footer-top"><a href="/" class="footer-name">Keep<br/>making.</a><div><p>让想法继续发生。</p><a class="text-link" href="mailto:ethandev@qq.com">ethandev@qq.com <Icon name="diagonal" size={18}/></a></div><a class="footer-back" href="#main" aria-label="返回页面顶部">回到顶部 <Icon name="up" size={16}/></a></div>
      <div class="footer-bottom"><span>© 2025–{new Date().getFullYear()} Ethan · CC BY-NC 4.0</span><span>用感觉编码，用日志留下痕迹。</span><a href="https://github.com/EthanAIDev" target="_blank" rel="noopener noreferrer">GitHub <Icon name="diagonal" size={13}/></a></div>
    </footer>
    <script>import '../lib/site';</script>
  </body>
</html>
