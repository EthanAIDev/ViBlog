---
import Layout from '../layouts/Layout.astro';
import SiliconHero from '../components/SiliconHero';
import Icon from '../components/Icon.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { getPosts, getProjects } from '../lib/content';

const projects = getProjects();
const posts = getPosts();
---
<Layout>
  <SiliconHero client:idle />

  <section id="selected-work" class="selected-systems page-shell">
    <div class="section-head" data-reveal>
      <div>
        <span class="section-kicker">SELECTED SYSTEMS</span>
        <h2>核心工程项目</h2>
      </div>
      <a class="text-link" href="/projects/">全部项目 <Icon name="arrow" size={18} /></a>
    </div>

    <div class="featured-works">
      {projects.slice(0, 2).map((project, index) => (
        <article class="featured-work" data-reveal>
          <a class="featured-image" href={project.href}>
            <ResponsiveImage
              src={project.cover}
              alt={`${project.name} 实际界面`}
              sizes="(max-width: 760px) 90vw, 50vw"
            />
          </a>
          <div class="featured-copy">
            <span class="work-number">{String(index + 1).padStart(2, '0')} · {project.focus.toUpperCase()}</span>
            <h3><a href={project.href}>{project.name}</a></h3>
            <p>{project.shortSummary}</p>
            <div class="tech-pills">
              {project.technologies.map((tech) => <span>{tech}</span>)}
            </div>
            <a class="text-link" href={project.href}>深入架构与实现 <Icon name="diagonal" size={18} /></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-writing page-shell" data-reveal>
    <div class="section-head" style="margin-bottom: 24px;">
      <div>
        <span class="section-kicker">ENGINEERING NOTES</span>
        <h2>技术笔记与复盘</h2>
      </div>
      <a class="text-link" href="/posts/">全部文章 <Icon name="arrow" size={18} /></a>
    </div>
    <div class="home-note-list">
      {posts.map((post) => (
        <a href={post.href}>
          <div class="note-meta">
            <time datetime={post.date}>{post.displayDate}</time>
            <span>{post.type}</span>
          </div>
          <h3>{post.title}</h3>
          <span class="note-arrow"><Icon name="diagonal" size={22} /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-about page-shell" data-reveal>
    <h2>让复杂技术，<br />成为可理解的体验。</h2>
    <div>
      <p>我是 Ethan，AI Agent 开发工程师。关注智能体编排、知识检索与工具调用，用工程化的方式把大模型能力落地为可解释、可维护的真实系统。</p>
      <a class="text-link" href="/about/">关于我与联系方式 <Icon name="arrow" size={18} /></a>
    </div>
  </section>
</Layout>
