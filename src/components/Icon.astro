---
interface Props { name?: string; size?: number; }
import { iconPaths } from '../lib/icons';
const { name = 'arrow', size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={iconPaths[name] || iconPaths.arrow}/></svg>
