---
import type {HTMLAttributes} from 'astro/types';
import {optimizedImage,imageVariant} from '../lib/images';
interface Props extends HTMLAttributes<'img'>{src:string;alt:string;}
const {src,alt,loading='lazy',sizes='100vw',...attributes}=Astro.props;
const image=optimizedImage(src);
---
<img {...attributes} src={imageVariant(src,960)} srcset={image?.variants.map(variant=>`${variant.src} ${variant.width}w`).join(', ')} sizes={image?sizes:undefined} width={image?.width||attributes.width} height={image?.height||attributes.height} alt={alt} loading={loading} decoding="async"/>
