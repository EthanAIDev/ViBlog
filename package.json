{
  "name": "ethan-ai-lab",
  "version": "1.0.0",
  "description": "Ethan 的认知剧场、技术文章与项目作品集",
  "scripts": {
    "start": "npm run dev",
    "assets": "node scripts/sync-public.mjs && node scripts/optimize-images.mjs",
    "predev": "npm run assets",
    "dev": "astro dev --host 127.0.0.1 --port 3000",
    "build": "node build-manifest.cjs && npm run assets && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 3000",
    "check": "astro check",
    "verify:release": "npm run check && npm run build && node scripts/inspect-release.mjs",
    "build-manifest": "node build-manifest.cjs"
  },
  "keywords": [
    "blog",
    "static-site"
  ],
  "license": "MIT",
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.2",
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "0.35.5",
    "three": "^0.186.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "overrides": {
    "katex": "$katex"
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  }
}
