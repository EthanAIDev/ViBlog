/
  Cache-Control: no-cache, must-revalidate

/*.html
  Cache-Control: no-cache, must-revalidate

/posts/*
  Cache-Control: no-cache, must-revalidate

/articles/*
  Cache-Control: no-cache, must-revalidate

/projects/*
  Cache-Control: no-cache, must-revalidate

/about/*
  Cache-Control: no-cache, must-revalidate

/robots.txt
  Cache-Control: no-cache, must-revalidate

/sitemap.xml
  Cache-Control: no-cache, must-revalidate

/social/*
  Cache-Control: no-cache, must-revalidate

