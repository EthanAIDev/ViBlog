/
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

/*.html
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

/posts/*
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

/articles/*
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

/projects/*
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

/about/*
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

/robots.txt
  Cache-Control: no-cache, must-revalidate

/sitemap.xml
  Cache-Control: no-cache, must-revalidate

/social/*
  Cache-Control: no-cache, must-revalidate

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/media/*.webp
  Cache-Control: public, max-age=31536000, immutable

/media/manifest.json
  Cache-Control: no-cache, must-revalidate
